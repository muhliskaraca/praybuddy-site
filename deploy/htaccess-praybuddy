# Pray Buddy — Apache-Variante (.htaccess)
#
# Nur verwenden, wenn hinter dem nginx ein Apache läuft (bei Plesk üblich).
# Dann diese Datei als ".htaccess" ins Web-Root von praybuddy.likafilm.com legen.
# Läuft ausschließlich nginx, greift .htaccess NICHT — dann deploy/nginx-praybuddy.conf nutzen.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1) HTTP → HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://praybuddy.likafilm.com/$1 [R=301,L]

    # 2) www → ohne www
    RewriteCond %{HTTP_HOST} ^www\.praybuddy\.likafilm\.com$ [NC]
    RewriteRule ^(.*)$ https://praybuddy.likafilm.com/$1 [R=301,L]

    # 3) /index.html → /  (und /de/index.html → /de/)
    RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
    RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

# Statische Assets lange cachen
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType text/html "access plus 10 minutes"
</IfModule>
