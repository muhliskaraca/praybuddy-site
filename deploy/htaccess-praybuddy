# Pray Buddy: .htaccess für ALL-INKL.COM
#
# DIES IST DER RICHTIGE WEG FÜR DAS AKTUELLE HOSTING.
#
# Die Seite liegt bei ALL-INKL (Neue Medien Münnich GmbH, 85.13.153.47).
# Dort läuft nginx nur als Proxy, dahinter Apache mit mod_rewrite, .htaccess
# greift also. Root-Zugriff für eine nginx-Konfiguration gibt es nicht.
#
# Diese Datei als ".htaccess" (mit führendem Punkt, ohne Endung) ins Web-Root
# der Subdomain praybuddy.likafilm.com legen.
#
# REIHENFOLGE IST WICHTIG: Die Redirects stehen vor dem 404-Catch-all.
# Steht der Catch-all davor, greifen die Redirects nie.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1) HTTP auf HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://praybuddy.likafilm.com/$1 [R=301,L]

    # 2) www auf ohne www
    RewriteCond %{HTTP_HOST} ^www\.praybuddy\.likafilm\.com$ [NC]
    RewriteRule ^(.*)$ https://praybuddy.likafilm.com/$1 [R=301,L]

    # 3) /index.html auf /  (und /de/index.html auf /de/)
    RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
    RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

    # 4) 404 statt 500 für fehlende URLs (Fix vom 29.07.2026, NICHT entfernen).
    #    "ErrorDocument 404 /404.html" wird auf den likafilm-Subdomains
    #    nachweislich ignoriert, deshalb fängt mod_rewrite alles ab, was weder
    #    Datei noch Verzeichnis ist, und 404.php setzt den Status selbst.
    #    Gleicher Fix wie heftig, dicta, lostheimatland, studio.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /404.php [L]
</IfModule>

ErrorDocument 404 /404.php

# Sicherheits-Header. Die CSP ist bewusst eng: die Seite laedt keine einzige
# fremde Ressource mehr, seit die Schriften lokal liegen. 'unsafe-inline' ist
# noetig, weil CSS und das kleine Skript direkt im HTML stehen.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), interest-cohort=()"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# Statische Assets lange cachen
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 10 minutes"
</IfModule>

# Die Schriftdateien sind unveraenderlich, der Name wechselt bei einem Update.
<IfModule mod_headers.c>
    <FilesMatch "\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
